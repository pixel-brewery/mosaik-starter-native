{
  "name": "mosaik-starter-native",
  "private": true,
  "version": "0.0.0",
  "description": "Independent TypeScript and Web Components starter for Mosaik.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
