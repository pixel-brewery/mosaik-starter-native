  },
  "dependencies": {
    "@pixel-brewery/mosaik-elements-foundation": "0.1.178",
    "@pixel-brewery/mosaik-icons": "0.1.178",
    "@pixel-brewery/mosaik-themes": "0.1.178",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.4.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
